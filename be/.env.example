NODE_ENV=development
# NODE_ENV=production

# MongoDB connection for backend
MONGO_URI=mongodb://localhost:27017/AcongKelontongLocal?retryWrites=true&w=majority&replicaSet=rs0
# For Docker Compose replica set:
# MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/AcongKelontongLocal?replicaSet=rs0&retryWrites=true&w=majority
PORT=3200

# JWT & SMTP (for your app)
JWT_SECRET=your_jwt_secret
SMTP_USER=your@mail.com
SMTP_PASS=yourpass
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend domain
FE_DOMAIN=https://ack.dekolapps.tech
IS_PROD=false
URL_CHANGE_PASSWORD=user-verification
