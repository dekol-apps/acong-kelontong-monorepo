# Global runtime mode
NODE_ENV=production

# App ports
BE_PORT=3200
FE_PORT=4200

# Frontend build-time values
FE_API_URL=http://localhost:3200/api
FE_ENCRYPTION_KEY=1234

# Backend runtime values
FE_DOMAIN=http://localhost:4200
JWT_SECRET=replace_with_a_long_random_secret
SMTP_USER=your@mail.com
SMTP_PASS=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Replica set connection string (required for Mongo transactions)
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/AcongKelontongLocal?replicaSet=rs0&retryWrites=true&w=majority
